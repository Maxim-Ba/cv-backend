package components

import (
	"strconv"

	models "github.com/Maxim-Ba/cv-backend/internal/models/gen"
)

type EntityFormData struct {
	EntityName string
	Fields     []FormField
	ActionURL  string
	Method     string // "POST" || "PUT"
	EntityID   int64
	CSRFToken  string
}

type FormField struct {
	Name        string
	Label       string
	Type        string
	Value       string
	Placeholder string
	Required    bool
	IsTextArea  bool
}

templ ModalForm(data EntityFormData) {
	<div id="entityModal" class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-lg" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">
						if data.EntityID > 0 {
							Редактировать { data.EntityName }
						} else {
							Добавить { data.EntityName }
						}
					</h5>
					<a href="?" class="close" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</a>
				</div>
				<div class="modal-body">
					<form method="POST" action={ data.ActionURL }>
						<input type="hidden" name="_method" value={ data.Method }/>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						if data.EntityID > 0 {
							<input type="hidden" name="id" value={ strconv.FormatInt(data.EntityID, 10) }/>
						}
						for _, field := range data.Fields {
							<div class="mb-3">
								<label for={ "field-" + field.Name } class="form-label">{ field.Label }</label>
								if field.IsTextArea {
									<textarea
										class="form-control"
										id={ "field-" + field.Name }
										name={ field.Name }
										rows="3"
										placeholder={ field.Placeholder }
										required?={ field.Required }
									>{ field.Value }</textarea>
								} else if field.Type == "color" {
									<div class="input-group">
										<input
											type="color"
											class="form-control form-control-color"
											id={ "field-" + field.Name + "-picker" }
											value={ field.Value }
											oninput="adminSyncColorToText(this)"
											title="Выберите цвет"
										/>
										<input
											type="text"
											class="form-control font-monospace"
											id={ "field-" + field.Name }
											name={ field.Name }
											value={ field.Value }
											placeholder={ field.Placeholder }
											required?={ field.Required }
											oninput="adminSyncTextToPicker(this)"
										/>
									</div>
								} else {
									<input
										type={ field.Type }
										class="form-control"
										id={ "field-" + field.Name }
										name={ field.Name }
										value={ field.Value }
										placeholder={ field.Placeholder }
										required?={ field.Required }
									/>
								}
							</div>
						}
						<div class="modal-footer">
							<a href="?" class="btn btn-secondary">Отмена</a>
							<button type="submit" class="btn btn-primary">
								if data.EntityID > 0 {
									Сохранить
								} else {
									Создать
								}
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
}

func TechnologyFormData(tech models.Technology, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}
	
	return EntityFormData{
		EntityName: "Technology",
		ActionURL:  "/admin/tech",
		Method:     method,
		EntityID:   tech.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "title",
				Label:       "Название",
				Type:        "text",
				Value:       tech.Title,
				Placeholder: "Введите название технологии",
				Required:    true,
			},
			{
				Name:        "description",
				Label:       "Описание",
				Type:        "text",
				Value:       tech.Description.String,
				Placeholder: "Введите описание",
				IsTextArea:  true,
				Required:    false,
			},
			{
				Name:        "logoUrl",
				Label:       "URL логотипа",
				Type:        "url",
				Value:       tech.LogoUrl.String,
				Placeholder: "https://example.com/logo.png",
				Required:    false,
			},
		},
	}
}

func EducationFormData(edu models.Education, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}

	return EntityFormData{
		EntityName: "Education",
		ActionURL:  "/admin/education",
		Method:     method,
		EntityID:   edu.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "name",
				Label:       "Название",
				Type:        "text",
				Value:       edu.Name.String,
				Placeholder: "Введите название учебного заведения",
				Required:    true,
			},
			{
				Name:        "year",
				Label:       "Год окончания",
				Type:        "number",
				Value:       strconv.Itoa(int(edu.Year)),
				Placeholder: "2020",
				Required:    true,
			},
			{
				Name:        "course",
				Label:       "Направление / курс",
				Type:        "text",
				Value:       edu.Course,
				Placeholder: "Программная инженерия",
				Required:    true,
			},
			{
				Name:        "organization",
				Label:       "Организация",
				Type:        "text",
				Value:       edu.Organization,
				Placeholder: "МГТУ им. Баумана",
				Required:    true,
			},
		},
	}
}

func WorkHistoryFormData(wh models.WorkHistory, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}

	periodStart := ""
	if wh.PeriodStart.Valid {
		periodStart = wh.PeriodStart.Time.Format("2006-01-02")
	}
	periodEnd := ""
	if wh.PeriodEnd.Valid {
		periodEnd = wh.PeriodEnd.Time.Format("2006-01-02")
	}

	whatIDid := ""
	for i, item := range wh.WhatIDid {
		if i > 0 {
			whatIDid += "\n"
		}
		whatIDid += item
	}

	projects := ""
	for i, item := range wh.Projects {
		if i > 0 {
			projects += "\n"
		}
		projects += item
	}

	return EntityFormData{
		EntityName: "WorkHistory",
		ActionURL:  "/admin/history",
		Method:     method,
		EntityID:   wh.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "name",
				Label:       "Название компании",
				Type:        "text",
				Value:       wh.Name,
				Placeholder: "ООО Рога и Копыта",
				Required:    true,
			},
			{
				Name:        "about",
				Label:       "О компании",
				Type:        "text",
				Value:       wh.About,
				Placeholder: "Краткое описание компании",
				IsTextArea:  true,
				Required:    true,
			},
			{
				Name:        "logoUrl",
				Label:       "URL логотипа",
				Type:        "url",
				Value:       wh.LogoUrl.String,
				Placeholder: "https://example.com/logo.png",
				Required:    false,
			},
			{
				Name:        "periodStart",
				Label:       "Начало работы",
				Type:        "date",
				Value:       periodStart,
				Placeholder: "",
				Required:    true,
			},
			{
				Name:        "periodEnd",
				Label:       "Конец работы (пусто = по наст. время)",
				Type:        "date",
				Value:       periodEnd,
				Placeholder: "",
				Required:    false,
			},
			{
				Name:        "whatIDid",
				Label:       "Что делал (каждый пункт с новой строки)",
				Type:        "text",
				Value:       whatIDid,
				Placeholder: "Разрабатывал микросервисы\nПроводил code review",
				IsTextArea:  true,
				Required:    false,
			},
			{
				Name:        "projects",
				Label:       "Проекты (каждый с новой строки)",
				Type:        "text",
				Value:       projects,
				Placeholder: "Проект А\nПроект Б",
				IsTextArea:  true,
				Required:    false,
			},
		},
	}
}

