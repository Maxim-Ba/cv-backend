package components

import (
	"strconv"

	models "github.com/Maxim-Ba/cv-backend/internal/models/gen"
	"github.com/Maxim-Ba/cv-backend/pkg/i18n"
)

type EntityFormData struct {
	EntityName string
	Fields     []FormField
	ActionURL  string
	Method     string // "POST" || "PUT"
	EntityID   int64
	CSRFToken  string
}

type FormField struct {
	Name        string
	Label       string
	Type        string
	Value       string
	ValueRU     string
	ValueEN     string
	Placeholder string
	Required    bool
	IsTextArea  bool
	Options     []FormFieldOption
}

type FormFieldOption struct {
	Value   string
	Label   string
	Checked bool
	Color   string
}

templ ModalForm(data EntityFormData) {
	<div id="entityModal" class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-lg" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">
						if data.EntityID > 0 {
							Редактировать { data.EntityName }
						} else {
							Добавить { data.EntityName }
						}
					</h5>
					<a href="?" class="close" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</a>
				</div>
				<div class="modal-body">
					<form method="POST" action={ data.ActionURL }>
						<input type="hidden" name="_method" value={ data.Method }/>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						if data.EntityID > 0 {
							<input type="hidden" name="id" value={ strconv.FormatInt(data.EntityID, 10) }/>
						}
						for _, field := range data.Fields {
							@renderFormField(field)
						}
						<div class="modal-footer">
							<a href="?" class="btn btn-secondary">Отмена</a>
							<button type="submit" class="btn btn-primary">
								if data.EntityID > 0 {
									Сохранить
								} else {
									Создать
								}
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
}

templ InlineEntityForm(data EntityFormData) {
	<form method="POST" action={ data.ActionURL } class="card card-body">
		<input type="hidden" name="_method" value={ data.Method }/>
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
		if data.EntityID > 0 {
			<input type="hidden" name="id" value={ strconv.FormatInt(data.EntityID, 10) }/>
		}
		for _, field := range data.Fields {
			@renderFormField(field)
		}
		<div class="d-flex justify-content-end">
			<button type="submit" class="btn btn-primary">Сохранить</button>
		</div>
	</form>
}

func TechnologyFormData(tech models.Technology, allTags []models.Tag, selectedTagIDs map[int64]bool, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}

	tagOptions := make([]FormFieldOption, 0, len(allTags))
	for _, tag := range allTags {
		tagOptions = append(tagOptions, FormFieldOption{
			Value:   strconv.FormatInt(tag.ID, 10),
			Label:   tag.Name.Get(i18n.LocaleRU),
			Checked: selectedTagIDs[tag.ID],
			Color:   tag.HexColor,
		})
	}

	return EntityFormData{
		EntityName: "Technology",
		ActionURL:  "/admin/tech",
		Method:     method,
		EntityID:   tech.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "title",
				Label:       "Название",
				Type:        "text",
				Value:       tech.Title,
				Placeholder: "Go, Angular",
				Required:    true,
			},
			nullableLocalizedField("description", "Описание", tech.Description, "Описание технологии", true),
			{
				Name:        "logoUrl",
				Label:       "URL логотипа",
				Type:        "url",
				Value:       tech.LogoUrl.String,
				Placeholder: "https://example.com/logo.png",
			},
			{
				Name:    "tagIds",
				Label:   "Теги",
				Type:    "checkbox-group",
				Options: tagOptions,
			},
		},
	}
}

func EducationFormData(edu models.Education, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}

	return EntityFormData{
		EntityName: "Education",
		ActionURL:  "/admin/education",
		Method:     method,
		EntityID:   edu.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			nullableLocalizedField("name", "Название", edu.Name, "Название учебного заведения", false),
			{
				Name:        "year",
				Label:       "Год окончания",
				Type:        "number",
				Value:       strconv.Itoa(int(edu.Year)),
				Placeholder: "2020",
				Required:    true,
			},
			localizedTextField("course", "Направление / курс", edu.Course, "Программная инженерия", true, false),
			localizedTextField("organization", "Организация", edu.Organization, "МГТУ им. Баумана", true, false),
		},
	}
}

func WorkHistoryFormData(wh models.WorkHistory, allTechnologies []models.Technology, selectedTechnologyIDs map[int64]bool, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}

	periodStart := ""
	if wh.PeriodStart.Valid {
		periodStart = wh.PeriodStart.Time.Format("2006-01-02")
	}
	periodEnd := ""
	if wh.PeriodEnd.Valid {
		periodEnd = wh.PeriodEnd.Time.Format("2006-01-02")
	}

	technologyOptions := make([]FormFieldOption, 0, len(allTechnologies))
	for _, tech := range allTechnologies {
		technologyOptions = append(technologyOptions, FormFieldOption{
			Value:   strconv.FormatInt(tech.ID, 10),
			Label:   tech.Title,
			Checked: selectedTechnologyIDs[tech.ID],
			Color:   "#6c757d",
		})
	}

	return EntityFormData{
		EntityName: "WorkHistory",
		ActionURL:  "/admin/history",
		Method:     method,
		EntityID:   wh.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			localizedTextField("name", "Название компании", wh.Name, "ООО Рога и Копыта", true, false),
			nullableLocalizedField("jobTitle", "Должность", wh.JobTitle, "Senior Backend Developer", false),
			localizedTextField("about", "О компании", wh.About, "Краткое описание компании", true, true),
			{
				Name:        "logoUrl",
				Label:       "URL логотипа",
				Type:        "url",
				Value:       wh.LogoUrl.String,
				Placeholder: "https://example.com/logo.png",
			},
			{
				Name:     "periodStart",
				Label:    "Начало работы",
				Type:     "date",
				Value:    periodStart,
				Required: true,
			},
			{
				Name:  "periodEnd",
				Label: "Конец работы (пусто = по наст. время)",
				Type:  "date",
				Value: periodEnd,
			},
			localizedListField("whatIDid", "Что делал (каждый пункт с новой строки)", wh.WhatIDid, "Разрабатывал микросервисы"),
			localizedListField("projects", "Проекты (каждый с новой строки)", wh.Projects, "Проект А"),
			{
				Name:    "technologyIds",
				Label:   "Технологии",
				Type:    "checkbox-group",
				Options: technologyOptions,
			},
		},
	}
}

func AboutMeFormData(about, note, hobbies i18n.LocalizedText, allTech []models.Technology, selectedTechnologyIDs map[int64]bool, csrfToken string) EntityFormData {
	technologyOptions := make([]FormFieldOption, 0, len(allTech))
	for _, tech := range allTech {
		technologyOptions = append(technologyOptions, FormFieldOption{
			Value:   strconv.FormatInt(tech.ID, 10),
			Label:   tech.Title,
			Checked: selectedTechnologyIDs[tech.ID],
			Color:   "#6c757d",
		})
	}

	return EntityFormData{
		EntityName: "AboutMe",
		ActionURL:  "/admin/about-me",
		Method:     "PUT",
		EntityID:   1,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			localizedTextField("about", "Биография (абзацы через пустую строку)", about, "Первый абзац\n\nВторой абзац", false, true),
			{
				Name:    "technologyIds",
				Label:   "Технологии (бейджи)",
				Type:    "checkbox-group",
				Options: technologyOptions,
			},
			localizedTextField("note", "Заметка", note, "Краткая заметка", false, true),
			localizedTextField("hobbies", "Хобби", hobbies, "Мои хобби: ...", false, true),
		},
	}
}

func HeroFormData(greeting, fullName, title, pitch i18n.LocalizedText, profileID int64, csrfToken string) EntityFormData {
	return EntityFormData{
		EntityName: "Hero",
		ActionURL:  "/admin/hero",
		Method:     "PUT",
		EntityID:   profileID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			localizedTextField("greeting", "Приветствие", greeting, "Здравствуйте!", true, false),
			localizedTextField("fullName", "Имя", fullName, "Балашов Максим", true, false),
			localizedTextField("title", "Должность", title, "Full-Stack разработчик", true, false),
			localizedTextField("pitch", "Краткое описание", pitch, "Эта страница рассказывает...", false, true),
		},
	}
}

func TagFormData(tag models.Tag, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}

	return EntityFormData{
		EntityName: "Tag",
		ActionURL:  "/admin/tag",
		Method:     method,
		EntityID:   tag.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			localizedTextField("name", "Название", tag.Name, "Frontend", true, false),
			{
				Name:        "hexColor",
				Label:       "Цвет (HEX)",
				Type:        "color",
				Value:       tag.HexColor,
				Placeholder: "#FF0077",
				Required:    true,
			},
		},
	}
}
