	method := "POST"
	if isEdit {
		method = "PUT"
	}
	
	return EntityFormData{
		EntityName: "Tag",
		ActionURL:  "/admin/tag",
		Method:     method,
		EntityID:   tag.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "name",
				Label:       "Название",
