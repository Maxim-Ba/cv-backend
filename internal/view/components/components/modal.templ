package components

import (
	"strconv"

	models "github.com/Maxim-Ba/cv-backend/internal/models/gen"
)

type EntityFormData struct {
	EntityName string
	Fields     []FormField
	ActionURL  string
	Method     string // "POST" || "PUT"
	EntityID   int64
	CSRFToken  string
}

type FormField struct {
	Name        string
	Label       string
	Type        string
	Value       string
	Placeholder string
	Required    bool
	IsTextArea  bool
	Options     []FormFieldOption
}

type FormFieldOption struct {
	Value   string
	Label   string
	Checked bool
	Color   string
}

templ ModalForm(data EntityFormData) {
	<div id="entityModal" class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-lg" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">
						if data.EntityID > 0 {
							Редактировать { data.EntityName }
						} else {
							Добавить { data.EntityName }
						}
					</h5>
					<a href="?" class="close" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</a>
				</div>
				<div class="modal-body">
					<form method="POST" action={ data.ActionURL }>
						<input type="hidden" name="_method" value={ data.Method }/>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						if data.EntityID > 0 {
							<input type="hidden" name="id" value={ strconv.FormatInt(data.EntityID, 10) }/>
						}
						for _, field := range data.Fields {
							<div class="mb-3">
								<label for={ "field-" + field.Name } class="form-label">{ field.Label }</label>
								if field.IsTextArea {
									<textarea
										class="form-control"
										id={ "field-" + field.Name }
										name={ field.Name }
										rows="3"
										placeholder={ field.Placeholder }
										required?={ field.Required }
									>{ field.Value }</textarea>
								} else if field.Type == "checkbox-group" {
									<div class="d-flex flex-wrap gap-2">
										for _, opt := range field.Options {
											<div class="form-check">
												<input
													class="form-check-input"
													type="checkbox"
													name={ field.Name }
													value={ opt.Value }
													id={ "field-" + field.Name + "-" + opt.Value }
													checked?={ opt.Checked }
												/>
												<label class="form-check-label" for={ "field-" + field.Name + "-" + opt.Value }>
													<span class="badge" style={ "background-color: " + opt.Color }>{ opt.Label }</span>
												</label>
											</div>
										}
									</div>
								} else if field.Type == "color" {
									<div class="input-group">
										<input
											type="color"
											class="form-control form-control-color"
											id={ "field-" + field.Name + "-picker" }
											value={ field.Value }
											oninput="adminSyncColorToText(this)"
											title="Выберите цвет"
										/>
										<input
											type="text"
											class="form-control font-monospace"
											id={ "field-" + field.Name }
											name={ field.Name }
											value={ field.Value }
											placeholder={ field.Placeholder }
											required?={ field.Required }
											oninput="adminSyncTextToPicker(this)"
										/>
									</div>
								} else {
									<input
										type={ field.Type }
										class="form-control"
										id={ "field-" + field.Name }
										name={ field.Name }
										value={ field.Value }
										placeholder={ field.Placeholder }
										required?={ field.Required }
									/>
								}
							</div>
						}
						<div class="modal-footer">
							<a href="?" class="btn btn-secondary">Отмена</a>
							<button type="submit" class="btn btn-primary">
								if data.EntityID > 0 {
									Сохранить
								} else {
									Создать
								}
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
}

templ InlineEntityForm(data EntityFormData) {
	<form method="POST" action={ data.ActionURL } class="card card-body">
		<input type="hidden" name="_method" value={ data.Method }/>
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
		if data.EntityID > 0 {
			<input type="hidden" name="id" value={ strconv.FormatInt(data.EntityID, 10) }/>
		}
		for _, field := range data.Fields {
			<div class="mb-3">
				<label for={ "field-" + field.Name } class="form-label">{ field.Label }</label>
				if field.IsTextArea {
					<textarea
						class="form-control"
						id={ "field-" + field.Name }
						name={ field.Name }
						rows="5"
						placeholder={ field.Placeholder }
						required?={ field.Required }
					>{ field.Value }</textarea>
				} else if field.Type == "checkbox-group" {
					<div class="d-flex flex-wrap gap-2">
						for _, opt := range field.Options {
							<div class="form-check">
								<input
									class="form-check-input"
									type="checkbox"
									name={ field.Name }
									value={ opt.Value }
									id={ "field-" + field.Name + "-" + opt.Value }
									checked?={ opt.Checked }
								/>
								<label class="form-check-label" for={ "field-" + field.Name + "-" + opt.Value }>
									<span class="badge" style={ "background-color: " + opt.Color }>{ opt.Label }</span>
								</label>
							</div>
						}
					</div>
				} else {
					<input
						type={ field.Type }
						class="form-control"
						id={ "field-" + field.Name }
						name={ field.Name }
						value={ field.Value }
						placeholder={ field.Placeholder }
						required?={ field.Required }
					/>
				}
			</div>
		}
		<div class="d-flex justify-content-end">
			<button type="submit" class="btn btn-primary">Сохранить</button>
		</div>
	</form>
}

func TechnologyFormData(tech models.Technology, allTags []models.Tag, selectedTagIDs map[int64]bool, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}

	tagOptions := make([]FormFieldOption, 0, len(allTags))
	for _, tag := range allTags {
		tagOptions = append(tagOptions, FormFieldOption{
			Value:   strconv.FormatInt(tag.ID, 10),
			Label:   tag.Name,
			Checked: selectedTagIDs[tag.ID],
			Color:   tag.HexColor,
		})
	}

	return EntityFormData{
		EntityName: "Technology",
		ActionURL:  "/admin/tech",
		Method:     method,
		EntityID:   tech.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "title",
				Label:       "Название",
				Type:        "text",
				Value:       tech.Title,
				Placeholder: "Введите название технологии",
				Required:    true,
			},
			{
				Name:        "description",
				Label:       "Описание",
				Type:        "text",
				Value:       tech.Description.String,
				Placeholder: "Введите описание",
				IsTextArea:  true,
				Required:    false,
			},
			{
				Name:        "logoUrl",
				Label:       "URL логотипа",
				Type:        "url",
				Value:       tech.LogoUrl.String,
				Placeholder: "https://example.com/logo.png",
				Required:    false,
			},
			{
				Name:    "tagIds",
				Label:   "Теги",
				Type:    "checkbox-group",
				Options: tagOptions,
			},
		},
	}
}

func EducationFormData(edu models.Education, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}

	return EntityFormData{
		EntityName: "Education",
		ActionURL:  "/admin/education",
		Method:     method,
		EntityID:   edu.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "name",
				Label:       "Название",
				Type:        "text",
				Value:       edu.Name.String,
				Placeholder: "Введите название учебного заведения",
				Required:    true,
			},
			{
				Name:        "year",
				Label:       "Год окончания",
				Type:        "number",
				Value:       strconv.Itoa(int(edu.Year)),
				Placeholder: "2020",
				Required:    true,
			},
			{
				Name:        "course",
				Label:       "Направление / курс",
				Type:        "text",
				Value:       edu.Course,
				Placeholder: "Программная инженерия",
				Required:    true,
			},
			{
				Name:        "organization",
				Label:       "Организация",
				Type:        "text",
				Value:       edu.Organization,
				Placeholder: "МГТУ им. Баумана",
				Required:    true,
			},
		},
	}
}

func WorkHistoryFormData(wh models.WorkHistory, allTechnologies []models.Technology, selectedTechnologyIDs map[int64]bool, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}

	periodStart := ""
	if wh.PeriodStart.Valid {
		periodStart = wh.PeriodStart.Time.Format("2006-01-02")
	}
	periodEnd := ""
	if wh.PeriodEnd.Valid {
		periodEnd = wh.PeriodEnd.Time.Format("2006-01-02")
	}

	whatIDid := ""
	for i, item := range wh.WhatIDid {
		if i > 0 {
			whatIDid += "\n"
		}
		whatIDid += item
	}

	projects := ""
	for i, item := range wh.Projects {
		if i > 0 {
			projects += "\n"
		}
		projects += item
	}

	technologyOptions := make([]FormFieldOption, 0, len(allTechnologies))
	for _, tech := range allTechnologies {
		technologyOptions = append(technologyOptions, FormFieldOption{
			Value:   strconv.FormatInt(tech.ID, 10),
			Label:   tech.Title,
			Checked: selectedTechnologyIDs[tech.ID],
			Color:   "#6c757d",
		})
	}

	return EntityFormData{
		EntityName: "WorkHistory",
		ActionURL:  "/admin/history",
		Method:     method,
		EntityID:   wh.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "name",
				Label:       "Название компании",
				Type:        "text",
				Value:       wh.Name,
				Placeholder: "ООО Рога и Копыта",
				Required:    true,
			},
			{
				Name:        "jobTitle",
				Label:       "Должность",
				Type:        "text",
				Value:       wh.JobTitle.String,
				Placeholder: "Senior Backend Developer",
				Required:    false,
			},
			{
				Name:        "about",
				Label:       "О компании",
				Type:        "text",
				Value:       wh.About,
				Placeholder: "Краткое описание компании",
				IsTextArea:  true,
				Required:    true,
			},
			{
				Name:        "logoUrl",
				Label:       "URL логотипа",
				Type:        "url",
				Value:       wh.LogoUrl.String,
				Placeholder: "https://example.com/logo.png",
				Required:    false,
			},
			{
				Name:        "periodStart",
				Label:       "Начало работы",
				Type:        "date",
				Value:       periodStart,
				Placeholder: "",
				Required:    true,
			},
			{
				Name:        "periodEnd",
				Label:       "Конец работы (пусто = по наст. время)",
				Type:        "date",
				Value:       periodEnd,
				Placeholder: "",
				Required:    false,
			},
			{
				Name:        "whatIDid",
				Label:       "Что делал (каждый пункт с новой строки)",
				Type:        "text",
				Value:       whatIDid,
				Placeholder: "Разрабатывал микросервисы\nПроводил code review",
				IsTextArea:  true,
				Required:    false,
			},
			{
				Name:        "projects",
				Label:       "Проекты (каждый с новой строки)",
				Type:        "text",
				Value:       projects,
				Placeholder: "Проект А\nПроект Б",
				IsTextArea:  true,
				Required:    false,
			},
			{
				Name:    "technologyIds",
				Label:   "Технологии",
				Type:    "checkbox-group",
				Options: technologyOptions,
			},
		},
	}
}

func AboutMeFormData(about, note, hobbies string, allTech []models.Technology, selectedTechnologyIDs map[int64]bool, csrfToken string) EntityFormData {
	technologyOptions := make([]FormFieldOption, 0, len(allTech))
	for _, tech := range allTech {
		technologyOptions = append(technologyOptions, FormFieldOption{
			Value:   strconv.FormatInt(tech.ID, 10),
			Label:   tech.Title,
			Checked: selectedTechnologyIDs[tech.ID],
			Color:   "#6c757d",
		})
	}

	return EntityFormData{
		EntityName: "AboutMe",
		ActionURL:  "/admin/about-me",
		Method:     "PUT",
		EntityID:   1,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "about",
				Label:       "Биография (абзацы через пустую строку)",
				Type:        "text",
				Value:       about,
				Placeholder: "Первый абзац\n\nВторой абзац",
				IsTextArea:  true,
				Required:    false,
			},
			{
				Name:    "technologyIds",
				Label:   "Технологии (бейджи)",
				Type:    "checkbox-group",
				Options: technologyOptions,
			},
			{
				Name:        "note",
				Label:       "Заметка",
				Type:        "text",
				Value:       note,
				Placeholder: "Краткая заметка",
				IsTextArea:  true,
				Required:    false,
			},
			{
				Name:        "hobbies",
				Label:       "Хобби",
				Type:        "text",
				Value:       hobbies,
				Placeholder: "Мои хобби: ...",
				IsTextArea:  true,
				Required:    false,
			},
		},
	}
}

func TagFormData(tag models.Tag, csrfToken string, isEdit bool) EntityFormData {
	method := "POST"
	if isEdit {
		method = "PUT"
	}
	
	return EntityFormData{
		EntityName: "Tag",
		ActionURL:  "/admin/tag",
		Method:     method,
		EntityID:   tag.ID,
		CSRFToken:  csrfToken,
		Fields: []FormField{
			{
				Name:        "name",
				Label:       "Название",
				Type:        "text",
				Value:       tag.Name,
				Placeholder: "Введите название тега",
				Required:    true,
			},
			{
				Name:        "hexColor",
				Label:       "Цвет (HEX)",
				Type:        "color",
				Value:       tag.HexColor,
				Placeholder: "#FF0077",
				Required:    true,
			},
		},
	}
}
