package pages

import (
	"strconv"

	"github.com/Maxim-Ba/cv-backend/internal/models/gen"
	"github.com/Maxim-Ba/cv-backend/internal/view/components/components"
	"github.com/Maxim-Ba/cv-backend/internal/view/components/layout"
	"github.com/Maxim-Ba/cv-backend/pkg/entity-req-decorator"
)

templ EducationPage(user string, eduResult entityreqdecorator.PagebleRs[models.Education], editEdu models.Education, editID string, csrfToken string) {
	@layout.Base("Education", educationPage(eduResult, editEdu, editID, csrfToken), user)
}

templ educationPage(eduResult entityreqdecorator.PagebleRs[models.Education], editEdu models.Education, editID string, csrfToken string) {
	<div class="mb-3">
		<a href="?create=1" class="btn btn-success">+ Добавить образование</a>
	</div>
	@components.CRUDGrid(eduResult, components.Entity{Name: "education"}) {
		<table class="table table-striped">
			<thead>
				<tr>
					<th>ID</th>
					<th>Название</th>
					<th>Год</th>
					<th>Курс</th>
					<th>Организация</th>
					<th>Действия</th>
				</tr>
			</thead>
			<tbody>
				for _, edu := range eduResult.Content {
					<tr>
						<td>{ strconv.FormatInt(edu.ID, 10) }</td>
						<td>{ edu.Name.String }</td>
						<td>{ strconv.Itoa(int(edu.Year)) }</td>
						<td>{ edu.Course }</td>
						<td>{ edu.Organization }</td>
						<td>
							<a href={ "?edit=" + strconv.FormatInt(edu.ID, 10) } class="btn btn-sm btn-warning">Изменить</a>
							<form method="POST" action="/admin/education" style="display:inline;">
								<input type="hidden" name="_method" value="DELETE"/>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="id" value={ strconv.FormatInt(edu.ID, 10) }/>
								<button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить запись?')">Удалить</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
	if editID == "create" {
		@components.ModalForm(components.EducationFormData(models.Education{}, csrfToken, false))
	} else if editID != "" {
		@components.ModalForm(components.EducationFormData(editEdu, csrfToken, true))
	}
}
