package pages

import (
	"strconv"

	"github.com/Maxim-Ba/cv-backend/internal/models/gen"
	"github.com/Maxim-Ba/cv-backend/internal/view/components/components"
	"github.com/Maxim-Ba/cv-backend/internal/view/components/layout"
	"github.com/Maxim-Ba/cv-backend/pkg/entity-req-decorator"
)

templ TechPage(user string, techResult entityreqdecorator.PagebleRs[models.Technology], editTech models.Technology, editID string, csrfToken string) {
	@layout.Base("Tech", techPage(techResult, editTech, editID, csrfToken), user)
}

templ techPage(techResult entityreqdecorator.PagebleRs[models.Technology], editTech models.Technology, editID string, csrfToken string) {
	<div class="mb-3">
		<a href="?create=1" class="btn btn-success">+ Создать технологию</a>
	</div>
	@components.CRUDGrid(techResult, components.Entity{Name: "tech"}) {
		<table class="table table-striped">
			<thead>
				<tr>
					<th>ID</th>
					<th>Название</th>
					<th>Описание</th>
					<th>Logo URL</th>
					<th>Действия</th>
				</tr>
			</thead>
			<tbody>
				for _, tech := range techResult.Content {
					<tr>
						<td>{ strconv.FormatInt(tech.ID, 10) }</td>
						<td>{ tech.Title }</td>
						<td>{ tech.Description.String }</td>
						<td>{ tech.LogoUrl.String }</td>
						<td>
							<a href={ "?edit=" + strconv.FormatInt(tech.ID, 10) } class="btn btn-sm btn-warning">Изменить</a>
							<form method="POST" action="/admin/tech" style="display:inline;">
								<input type="hidden" name="_method" value="DELETE"/>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="id" value={ strconv.FormatInt(tech.ID, 10) }/>
								<button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить технологию?')">Удалить</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
	if editID == "create" {
		@components.ModalForm(components.TechnologyFormData(models.Technology{}, csrfToken, false))
	} else if editID != "" {
		@components.ModalForm(components.TechnologyFormData(editTech, csrfToken, true))
	}
}
