package pages

import (
	"strconv"

	"github.com/Maxim-Ba/cv-backend/internal/models/dto"
	"github.com/Maxim-Ba/cv-backend/internal/models/gen"
	"github.com/Maxim-Ba/cv-backend/internal/view/components/components"
	"github.com/Maxim-Ba/cv-backend/internal/view/components/layout"
	"github.com/Maxim-Ba/cv-backend/pkg/entity-req-decorator"
)

templ HistoryPage(user string, whResult entityreqdecorator.PagebleRs[dto.WorkHistoryWithTechnologiesDTO], allTechnologies []models.Technology, selectedTechnologyIDs map[int64]bool, editWH models.WorkHistory, editID string, csrfToken string) {
	@layout.Base("History", historyPage(whResult, allTechnologies, selectedTechnologyIDs, editWH, editID, csrfToken), user)
}

templ historyPage(whResult entityreqdecorator.PagebleRs[dto.WorkHistoryWithTechnologiesDTO], allTechnologies []models.Technology, selectedTechnologyIDs map[int64]bool, editWH models.WorkHistory, editID string, csrfToken string) {
	<div class="mb-3">
		<a href="?create=1" class="btn btn-success">+ Добавить место работы</a>
	</div>
	@components.CRUDGrid(whResult, components.Entity{Name: "history"}) {
		<table class="table table-striped">
			<thead>
				<tr>
					<th>ID</th>
					<th>Название</th>
					<th>Должность</th>
					<th>О компании</th>
					<th>Начало</th>
					<th>Конец</th>
					<th>Технологии</th>
					<th>Действия</th>
				</tr>
			</thead>
			<tbody>
				for _, wh := range whResult.Content {
					<tr>
						<td>{ strconv.FormatInt(wh.ID, 10) }</td>
						<td>{ wh.Name }</td>
						<td>{ wh.JobTitle }</td>
						<td>{ wh.About }</td>
						<td>
							if wh.PeriodStart != nil {
								{ *wh.PeriodStart }
							}
						</td>
						<td>
							if wh.PeriodEnd != nil {
								{ *wh.PeriodEnd }
							} else {
								по наст. время
							}
						</td>
						<td>
							for _, tech := range wh.Technologies {
								<span class="badge bg-secondary me-1">{ tech.Title }</span>
							}
						</td>
						<td>
							<a href={ "?edit=" + strconv.FormatInt(wh.ID, 10) } class="btn btn-sm btn-warning">Изменить</a>
							<form method="POST" action="/admin/history" style="display:inline;">
								<input type="hidden" name="_method" value="DELETE"/>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="id" value={ strconv.FormatInt(wh.ID, 10) }/>
								<button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить запись?')">Удалить</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
	if editID == "create" {
		@components.ModalForm(components.WorkHistoryFormData(models.WorkHistory{}, allTechnologies, selectedTechnologyIDs, csrfToken, false))
	} else if editID != "" {
		@components.ModalForm(components.WorkHistoryFormData(editWH, allTechnologies, selectedTechnologyIDs, csrfToken, true))
	}
}
